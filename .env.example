# Copy to .env.local and fill in values from your Supabase project settings.
# NEVER commit real credentials.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Bypasses Row Level Security — never import into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical application URL used for auth redirects and invitation links
NEXT_PUBLIC_APP_URL=http://localhost:3000
